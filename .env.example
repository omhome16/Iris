# ── Iris configuration ──────────────────────────────────────────────
# Copy to .env and fill in. Model names use LiteLLM provider prefixes:
#   gemini/gemini-2.5-flash · groq/openai/gpt-oss-120b ·
#   openrouter/deepseek/deepseek-chat-v3.1:free · ollama/llama3.1:8b
#
# Provider pick: LLM_PROVIDER=<name>|auto  (registry: iris_ai/providers.py)
#   auto              — first usable key, in AUTO_ORDER
#   openrouter        — openrouter.ai/keys; *:free model variants are free
#   groq              — console.groq.com/keys (generous free tier)
#   gemini            — aistudio.google.com/apikey (chat + embeddings)
#   openai            — platform.openai.com/api-keys
#   deepseek          — platform.deepseek.com/api_keys
#   xai               — console.x.ai
#   mistral           — console.mistral.ai/api-keys
#   together          — api.together.ai/settings/api-keys
#   fireworks         — fireworks.ai/account/api-keys
#   opencode          — OpenCode Zen, opencode.ai/docs/zen (free models exist)
#   opencode-go       — OpenCode Go, opencode.ai/docs/go (shares OPENCODE_API_KEY)
#   openai-compatible — any OpenAI-compatible /v1 endpoint (vLLM, LM Studio,
#                       a self-hosted gateway): set _BASE_URL + a model id
#   ollama            — no key: run `ollama serve` + `ollama pull llama3.1:8b`
#
# A provider with no model id set is *not usable* — Iris skips it instead of
# guessing, and `iris doctor` reports which providers are ready.
#
# Embeddings: Gemini when GEMINI_API_KEY is set, otherwise automatic
# fallback to ollama/nomic-embed-text (Ollama must be running).
LLM_PROVIDER=auto

# Model tiers — strong thinks, cheap does memory grunt work.
# OpenRouter defaults target free (:free) variants.
STRONG_MODEL=gemini/gemini-3.5-flash
CHEAP_MODEL=gemini/gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=1536

# Provider keys (only the ones you use)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_STRONG_MODEL=groq/openai/gpt-oss-120b
GROQ_CHEAP_MODEL=groq/openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_STRONG_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_CHEAP_MODEL=openrouter/nvidia/nemotron-nano-9b-v2:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_STRONG_MODEL=ollama/qwen2.5-coder:3b
OLLAMA_CHEAP_MODEL=ollama/qwen2.5-coder:3b
# Embeddings fall back to Ollama when no Gemini key is set, so these matter on
# a keyless install. DIM must match the model or the index rejects the vector.
OLLAMA_EMBEDDING_MODEL=ollama/nomic-embed-text
OLLAMA_EMBEDDING_DIM=768

# ── Further providers ───────────────────────────────────────────────
# Each block is a key plus the strong/cheap model ids. Ids are LiteLLM-style
# and must include the provider prefix. These ship EMPTY on purpose: model ids
# drift constantly, and a wrong default is a 404 on every turn rather than an
# error you can see. Fill in the ones you use.

# OpenAI
OPENAI_API_KEY=
OPENAI_STRONG_MODEL=openai/gpt-4o
OPENAI_CHEAP_MODEL=openai/gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_STRONG_MODEL=deepseek/deepseek-chat
DEEPSEEK_CHEAP_MODEL=deepseek/deepseek-chat

# xAI Grok
XAI_API_KEY=
XAI_STRONG_MODEL=xai/grok-3-mini
XAI_CHEAP_MODEL=xai/grok-3-mini

# Mistral
MISTRAL_API_KEY=
MISTRAL_STRONG_MODEL=mistral/mistral-small-latest
MISTRAL_CHEAP_MODEL=mistral/mistral-small-latest

# Together AI (e.g. together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo)
TOGETHER_API_KEY=
TOGETHER_STRONG_MODEL=together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_CHEAP_MODEL=together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo

# Fireworks AI (e.g. fireworks_ai/accounts/fireworks/models/llama-v3p3-70b-instruct)
FIREWORKS_API_KEY=
FIREWORKS_STRONG_MODEL=fireworks_ai/accounts/fireworks/models/llama-v3p1-8b-instruct
FIREWORKS_CHEAP_MODEL=fireworks_ai/accounts/fireworks/models/llama-v3p1-8b-instruct

# Any LiteLLM model (Anthropic, Azure, Bedrock, Vertex, LM Studio, ...)
# LLM_PROVIDER=any and ANY_MODEL is the raw LiteLLM id. ANY_API_BASE is optional.
ANY_API_KEY=
ANY_MODEL=
ANY_API_BASE=

# OpenCode Zen — one key, curated gateway, free models available.
# Ids verified against opencode.ai/docs on 2026-09-26; re-check after upgrades.
OPENCODE_API_KEY=
OPENCODE_STRONG_MODEL=openai/deepseek-v4-pro
OPENCODE_CHEAP_MODEL=openai/deepseek-v4-flash-free
# OpenCode Go — same key, different endpoint (opencode.ai/zen/go/v1).
OPENCODE_GO_STRONG_MODEL=openai/deepseek-v4-pro
OPENCODE_GO_CHEAP_MODEL=openai/deepseek-v4-flash

# Bring your own OpenAI-compatible endpoint (vLLM, LM Studio, a gateway).
# Not needed for Zen/Go — those carry their own base URL.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_STRONG_MODEL=
OPENAI_COMPATIBLE_CHEAP_MODEL=

# Web search (free tier: tavily.com) — optional
TAVILY_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# Where iris-core reaches the Telegram MCP bridge (compose sets this to
# http://telegram-mcp:8100/mcp). Only the core reads it.
TELEGRAM_MCP_URL=http://127.0.0.1:8100/mcp

# Channels — which registered channels are live, by name. Core ships `telegram`;
# an installed plugin can register more (entry-point group `iris_ai.channels`),
# enabled here without a code change. Empty CHANNELS_ENABLED means "every
# registered channel"; CHANNELS_DISABLED always wins. A per-channel address
# override is CHANNEL_<NAME>_URL (e.g. CHANNEL_DISCORD_URL).
CHANNELS_ENABLED=telegram
CHANNELS_DISABLED=
CHANNEL_CONNECT_TIMEOUT_S=10

# Voice notes are transcribed by Groq Whisper; requires GROQ_API_KEY.
VOICE_MODEL=groq/whisper-large-v3-turbo

# Prompt identity — bump when a prompt changes. Rides on every turn trace with
# a fingerprint of the assembled prefix, so a quality shift is attributable to a
# prompt edit rather than guessed at.
PROMPT_VERSION=v1

# Kill switch — refuse every turn before it spends (no model call, no tool
# dispatch). Set true to stop Iris acting while you investigate something.
KILL_SWITCH=false

# Postgres (defaults match docker-compose). Only needed for the `pgvector`
# memory backend and the durable checkpointer; the default `sqlite` backend
# uses no daemon, so a fresh clone runs without this.
POSTGRES_DSN=postgresql+psycopg://iris:iris_dev_password@localhost:5433/iris

# Seconds to wait for Postgres before treating it as unreachable (libpq clamps
# to a 2s floor). psycopg's own default is 130s, which reads as a hang at boot —
# most visibly on Windows, where an unreachable server is never reported early.
# Lower it to fall through to the next checkpointer tier sooner.
POSTGRES_CONNECT_TIMEOUT=5

# The sqlite memory backend's file. One file beside the other runtime state;
# delete it to force a rebuild from the Markdown it indexes.
SQLITE_PATH=config/memory.db

# Which store keeps conversation threads — a separate choice from where recall
# lives. `auto` = Postgres when reachable, else the SQLite file, else in-memory
# (with a warning). `postgres` makes an unreachable database a boot error.
CHECKPOINTER_BACKEND=auto
CHECKPOINTER_PATH=config/checkpoints.db

# Capability backends — which registered implementation each kind uses. Core
# ships litellm / sqlite + pgvector + null / jev; a plugin can register another
# and select it here without a code change.
MODEL_BACKEND=litellm
MEMORY_BACKEND=sqlite
JUDGE_BACKEND=jev

# Declared MCP servers, in the ecosystem's shape: {"mcpServers": {"notes": {...}}}
# Each server carries its own `trust` (`owner` | `review` | `untrusted`) and
# `approval` (`auto` | `always` | `never`). A missing file means no servers.
# `untrusted` is the default: its writes are denied and its output is screened
# for instruction injection and tagged as data. `review` allows writes but still
# screens the output; `owner` is for servers you wrote yourself.
MCP_SERVERS_FILE=.mcp.json

# Where a secret lives when it is not in the environment. `auto` = the OS
# keychain when the optional `keyring` extra is installed, else a 0600 file that
# is NOT encrypted (and says so). `env` (read-only through Iris), `keyring`,
# `file` also work. `iris secrets` reports the choice, its location, and which
# ${VARS} your declared MCP servers still need.
SECRET_STORE=auto
SECRETS_FILE=config/secrets.json

# Telemetry (optional). `otlp` emits GenAI-convention spans through the optional
# extra `pip install 'iris-personal-ai[otel]'`, and FAILS THE BOOT if the extra is
# missing rather than leaving an empty dashboard behind. Tool arguments are a
# digest, never attributes. Leave it at `none` for a local single-user setup.
OTEL_EXPORTER=none
# OTLP endpoint; empty lets the exporter use OTEL_EXPORTER_OTLP_ENDPOINT / its default.
OTEL_ENDPOINT=
AGENT_NAME=iris

# Isolation for a skill's script (the one place the owner's code runs):
# `process` (default) = a real child process with a constructed environment (no
# secrets), no shell, a timeout, capped output. `container` = the same script in
# a rootless container: no network, read-only root, memory/PID caps, the skill
# mounted read-only. `container` FAILS CLOSED if the runtime is missing rather
# than quietly running the weaker one.
EXEC_SANDBOX=process
EXEC_CONTAINER_RUNTIME=docker
EXEC_CONTAINER_IMAGE=python:3.13-slim
EXEC_CONTAINER_MEMORY=512m
EXEC_CONTAINER_PIDS=128

# Iris
# Optional declarative manifest (TOML). Precedence: defaults < this file <
# manifest < environment (a *real* env var, not one this file introduced).
HARNESS_CONFIG=config/harness.toml
WORKSPACE_DIR=./workspace
SANDBOX_DIR=./workspace/sandbox
IRIS_TIMEZONE=UTC
NIGHTLY_SLEEP_HOUR=4
MORNING_BRIEF_HOUR=8

# Telegram: your chat id (find it with @userinfobot) — enables the morning
# brief. Also PINS bridge ownership: only this chat may talk to the bot or
# run commands; until it is set, the first /start to the bot claims it.
# Multiple ids: comma-separated.
OWNER_CHAT_ID=

# API auth: when set, every iris-core endpoint except /health requires
# "Authorization: Bearer <IRIS_API_TOKEN>"; the Telegram bridge
# forwards it automatically. When unset, auth is off (boot logs a warning).
# It is strongly recommended for any public/networked deployment.
IRIS_API_TOKEN=

# Graph guard: max steps per turn before the agent gets a friendly "let's
# take it one step at a time" fallback instead of an unhandled crash.
GRAPH_RECURSION_LIMIT=40

# ── Tool classes and the visible surface (P7) ──────────────────────
# Every tool declares a class (read/filesystem/memory_write/network/
# credentialed/delivery/control); the class yields a default policy
# (allow/ask/deny). Resolution is most-specific-wins with deny always winning,
# so a class-wide deny cannot be re-opened one tool at a time. Inspect it with
# `iris tools` or GET /tools. A malformed entry raises at boot; an unknown
# *name* is reported rather than stopping the process.
TOOL_POLICY_OVERRIDES=            # e.g. "send_message=deny,control=ask"
# Visible schema budget. `extended` tools defer past it (last-declared first);
# a deferred tool is still callable and `find_tools` restores its schema.
# 0 disables the budget entirely. Core tools are never deferred.
TOOL_SURFACE_BUDGET=20

# ── Pre-tool guards and budgets (P8, audit G1-G3) ───────────────────
# The ceilings that refuse *before* a tool is dispatched: budget -> circuit ->
# spiral/dedup. A refused call never reaches a provider, which is what makes a
# runaway loop cost ~$0.01 instead of ~$2 per 30 seconds.
TOOL_GUARD_ENABLED=true
TOOL_MAX_CALLS_PER_TURN=8        # normal is 1-3; past this the turn is stopped
TOOL_SPIRAL_MIN_REPEATS=3        # same tool + near-identical args this many times
TOOL_SPIRAL_JACCARD=0.72         # argument similarity that counts as "same call"
TOOL_FAILURE_THRESHOLD=2         # consecutive same-tool failures open the circuit
TOOL_FAILING_TOOLS_PER_TURN=3    # distinct failing tools escalate the turn
# Budget scopes with counters split by kind. 0 = no ceiling. The day ceiling
# persists to config/budget.json, so it survives a restart.
BUDGET_POLICY_VERSION=2026-09-25.1
BUDGET_MAX_TOKENS_PER_TURN=0
BUDGET_MAX_TOKENS_PER_DAY=0

# ── Approval integrity (P8, audit G4) ───────────────────────────────
# Bind a resume to the digest of the effective arguments, and let one
# tool_call_id be granted once per conversation thread.
APPROVAL_BIND_DIGEST=true
APPROVAL_GUARD_REPLAY=true

# ── Computer-use (P7) — off by default ─────────────────────────────
# Off means the `computer` tool is NOT registered at all. The permission model
# is the boundary, not the driver. Allowlists are matched by suffix; an EMPTY
# allowlist means nothing is allowed, not everything.
COMPUTER_ENABLED=false
COMPUTER_PROVIDER=null            # null | playwright (needs `iris[computer]`)
COMPUTER_ALLOWED_HOSTS=           # e.g. "example.com,docs.dev" for navigate
COMPUTER_ALLOWED_APPS=            # e.g. "Example" (title suffix) for click/type
COMPUTER_MAX_ACTIONS=12           # actions one approval buys
COMPUTER_ACTION_TIMEOUT_SECONDS=15.0
COMPUTER_CONFIRM_DESTRUCTIVE=true # click/type always confirm; credential fields too
# Policy statement, not a hypervisor: process isolation is not a containment
# boundary, so P7 permits owner-authored use only until a Wasm/microVM tier exists.
COMPUTER_ALLOW_OWNER_SCRIPTS_ONLY=true

# ── Capture (write-path safety net) ─────────────────────────────────
# Iris's memory tiers only fill up if conversations leave evidence behind. A
# deterministic prefilter decides whether a turn is worth a *judgment*, so
# "ok"/"thanks" turns cost nothing; the judgment itself is one JEV request
# when TYPESAFE_API_KEY is set, otherwise one cheap-tier call.
# Captured facts are ADD-only evidence in the daily note that must still pass
# dreaming's Light-phase gate before reaching MEMORY.md.
CAPTURE_ENABLED=true
CAPTURE_MIN_CHARS=25          # shorter turns cannot carry a durable fact
CAPTURE_USE_LLM=true          # cheap-tier fallback when JEV is unavailable
CAPTURE_MIN_IMPORTANCE=4.0    # 0-10 floor for a capture
CAPTURE_GATE=0.60             # JEV P(durable) required to capture
CAPTURE_ALREADY_KNOWN_GATE=0.50
CAPTURE_MAX_PER_DAY=50        # runaway guard on the daily note
CAPTURE_CONTEXT_CHARS=4000    # assembled prefix shown to the judgment (recall-loop guard)

# Semantic recall cache: repeated queries within the TTL skip embedding.
# Hits are invalidated automatically on any memory write/delete/forget.
RECALL_CACHE_ENABLED=true
RECALL_CACHE_TTL_SECONDS=60.0

# ── JEV (TypeSafe System One) — optional ─────────────────────────────
# Jev is not a chat model: it takes a state plus typed questions and returns
# calibrated probabilities. Iris uses it for three judgments that were
# previously hand-tuned heuristics:
#   • recall reranking    — is this memory relevant to this query?
#   • skill selection     — which stored procedure fits this turn, if any?
#   • injection screening — does this external page try to instruct me?
#   • capture gate        — is this turn a durable fact worth keeping?
#   • delegation          — does this ask need several independent answers?
#   • reflection          — is each sentence of the reply supported by recall?
# Every one of them is a *decision*; anything needing generation stays with the
# cheap-tier LLM. See docs/jev.md §3.0 for the audit.
#
# With no key every one of those falls back to its deterministic path, so the
# stack runs unchanged. Get a key at console.typesafe.ai; billing is on INPUT
# tokens only at $0.042/Mtok (jev-1.13.0), and one rerank is a single request.
# Docs: https://docs.typesafe.ai
TYPESAFE_API_KEY=
JEV_ENABLED=true
JEV_MODEL=jev-latest          # alias → jev-1.13.0; pin the version to freeze behaviour
JEV_TIMEOUT_SECONDS=12.0
# Tooling only (the eval lab): forces every integration onto its deterministic
# path without unsetting the key.
JEV_DISABLED_REASON=
JEV_RERANK_ENABLED=true
JEV_RERANK_CANDIDATES=20
JEV_RERANK_BLEND=0.15         # weight kept for the deterministic hybrid score
# Reply-path budget, separate from the client timeout: the agent's next call
# waits on a rerank, so past this the deterministic shortlist wins.
JEV_RERANK_TIMEOUT_SECONDS=2.5
JEV_SKILL_CANDIDATES=40
JEV_SKILL_GATE=0.30
JEV_SKILL_MIN_CONFIDENCE=0.30
JEV_GUARD_ENABLED=true
JEV_GUARD_BLOCK_THRESHOLD=0.70
JEV_GUARD_REVIEW_THRESHOLD=0.35
JEV_GUARD_SEVERITY_BLOCK=2.0
JEV_GUARD_SCAN_CHARS=12000
# Reflection: one batched judgment decides "is this claim supported by the
# excerpts" per sentence, so the fact-checking completion is not billed.
JEV_REFLECTION_ENABLED=true
JEV_REFLECTION_THRESHOLD=0.35
JEV_REFLECTION_MAX_CLAIMS=12

# ── Memory, context and chunking ─────────────────────────────────────
# What enters the prompt, and how documents are chunked before embedding.
# The prompt budgets are prefix budgets in stable order, so prompt caching
# keeps hitting across turns.
BOOTSTRAP_BUDGET_TOKENS=4000       # MEMORY.md
USER_PROFILE_BUDGET_TOKENS=1500    # USER.md
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=80            # overlap between neighbouring chunks
CONTEXTUAL_CHUNKING_ENABLED=true   # cheap-model context header per chunk (cached per file)
CONTEXT_HEADER_TOKENS=60
RECENCY_HALF_LIFE_DAYS=30          # a memory loses half its weight in this many days
ROT_THRESHOLD=0.2                  # below this, /rot flags the memory for review
COMPACTION_TRIGGER_TOKENS=12000    # history past this is summarised
COMPACTION_KEEP_TOKENS=2000        # recent history kept verbatim
COMPACTION_SUMMARY_TOKENS=400      # budget for the summary itself
LLM_CACHING=true                   # mark stable prompt prefixes as cacheable
RECALL_FEEDBACK_ENABLED=true       # record which hits were used; dreaming reads it
RECALL_FEEDBACK_MAX_BYTES=200000   # bounded: a signal file, not a log

# ── Dreaming (offline consolidation) ─────────────────────────────────
DREAM_NOTE_SCAN_DAYS=7             # how far back the Light phase reads daily notes
# Complex-typed settings (lists, tuples, dicts) must be JSON in the environment:
# pydantic-settings decodes those *before* validation, so a human-friendly
# `0.25,0.3,...` raised SettingsError on every command as soon as a user followed
# the quickstart's `cp .env.example .env`.
DREAM_LIGHT_WEIGHTS=[0.25,0.3,0.1,0.1,0.25]   # recency, frequency, richness, trigger-diversity, recall
DREAM_GATE_SCORE=0.5               # promotion score a staged fact must clear
DREAM_GATE_IMPORTANCE=6.0          # importance that overrides the score gate

# ── Skills ───────────────────────────────────────────────────────────
SKILLS_ENABLED=true
SKILLS_BUILTIN_DIR=skills          # skills shipped in this repo
SKILLS_EXTRA_DIRS=                 # comma-separated extra skill directories
SKILL_SCRIPT_TIMEOUT_SECONDS=10.0
SKILL_SCRIPT_MAX_OUTPUT_CHARS=20000
SKILL_SCRIPT_REQUIRE_APPROVAL=true
SKILL_GUARD_ENABLED=true           # JEV: does this script do only what its skill says?
SKILL_GUARD_GATE=0.6               # calibrated live: shipped script 0.72, exfiltrating variant 0.01

# ── Multi-agent delegation ───────────────────────────────────────────
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_CALLS=2            # delegations allowed per turn
MULTI_AGENT_MAX_PARALLEL=3
MULTI_AGENT_DEADLINE_MS=20000      # wall clock for the whole delegation
MULTI_AGENT_MAX_OUTPUT_CHARS=4000
MULTI_AGENT_EFFORT_GATE=0.6        # JEV P(needs several independent answers) to fan out
MULTI_AGENT_CRITIQUE_GATE=0.6      # JEV P(grounded enough) to skip the revision round
MULTI_AGENT_REVISE_ONCE=true
AGENTS_BUDGET_USD=0                # dollar ceiling for one turn's specialist calls; 0 = off

# ── Cron ─────────────────────────────────────────────────────────────
CRON_MAX_JOBS=50
CRON_MAX_FAILURES=3                # a job that keeps failing disables itself
CRON_MISFIRE_GRACE_SECONDS=3600    # how late a missed window may still fire
CRON_INTERVAL_CATCH_UP=false       # interval jobs do not replay every missed window

# ── Post-reply passes & observability ────────────────────────────────
# The reflection pass (hallucination triage) only appends to a telemetry file:
# it cannot change the reply, the memory or the trace, so it runs in the
# background instead of holding the turn open (~2-6 s saved per
# retrieval-backed turn). Set false to run it inline before the turn returns.
REFLECTION_BACKGROUND=true
BACKGROUND_DRAIN_TIMEOUT=10.0  # how long shutdown waits for in-flight passes
# Trace content policy: metadata (default) | redacted | sampled | full.
# Credentials never reach the trace file in any mode, and tool arguments are
# recorded as a hash rather than verbatim.
TRACE_CONTENT=metadata
TRACE_CONTENT_SAMPLE_RATE=0.0  # fraction of turns kept verbatim when sampled
TRACE_MAX_BYTES=1000000        # config/traces.jsonl rotates past this
# Per-turn judgment events + stage timings in config/traces.jsonl, kept for
# turn analysis (/mind, CLI later). Off = traces stay compact.
TURNLOG_ENABLED=true