# ── Iris configuration ──────────────────────────────────────────────
# Copy to .env and fill in. Model names use LiteLLM provider prefixes:
#   gemini/gemini-2.5-flash · gemini/gemini-2.5-flash-lite · gemini/gemini-embedding-001
#   openai/gpt-4.1 · groq/llama-3.3-70b-versatile ...

# Two-tier brain: strong model thinks, cheap model does memory grunt work.
# Defaults use the Gemini free tier — one key from aistudio.google.com/apikey
# covers chat + embeddings with no cost.
#
# Groq alternative: set GROQ_API_KEY and the strong/cheap tiers automatically
# switch to Groq (generous free tier, very fast). Embeddings still use Gemini
# because Groq does not offer them — you need GEMINI_API_KEY either way.
# Override the Groq models with GROQ_STRONG_MODEL / GROQ_CHEAP_MODEL.
STRONG_MODEL=gemini/gemini-3.5-flash
CHEAP_MODEL=gemini/gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=1536

# Provider keys (only the ones you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_STRONG_MODEL=groq/llama-3.3-70b-versatile
GROQ_CHEAP_MODEL=groq/llama-3.1-8b-instant

# Telegram
TELEGRAM_BOT_TOKEN=

# Postgres (defaults match docker-compose)
POSTGRES_DSN=postgresql+psycopg://iris:iris_dev_password@localhost:5433/iris

# Iris
WORKSPACE_DIR=./workspace
IRIS_TIMEZONE=UTC
