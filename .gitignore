# env
.env
*.env.local

# declared MCP servers (host config: commands, URLs, per-server trust). May name
# environment variables, so it is per-machine — config/mcp.json.example is the
# tracked template.
.mcp.json

# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# iris runtime — the whole config directory is live state (thread ids, the budget
# counter, the model-call ledger, backups of iris.json), never publishable by a
# blanket `git add -A`
workspace/config/
workspace/.dreams/

# owner state learned at runtime (the Telegram chat id, the update ledger). The
# files are recreated on demand, so a clone needs none of it.
data/

# generated by `scripts/eval_lab.py` — a measurement, not a source
reports/

# the owner's actual memory is personal data — keep it out of the repo
# (AGENTS.md and workspace/README.md stay tracked as the generic templates)
workspace/MEMORY.md
workspace/USER.md
workspace/DREAMS.md
workspace/memory/
workspace/sandbox/
# skills are learned from the owner's own life, so they are personal too —
# this directory holds real skills that must never be published by a blanket
# `git add`. The directory is recreated at boot when it is missing.
workspace/skills/
# ingested URLs (imports/*.md) are UNTRUSTED web content and still the owner's
# reading history — same rule as skills: never publishable by accident.
workspace/imports/

# Eval and evolve archives are run output.
workspace/eval/
workspace/evolve/
*.sqlite3
*.log

# the reference app's live state is personal too: running `examples/assistant/`
# writes real memory, so only the profile itself is tracked. Same rule as
# workspace/ above — a blanket `git add -A` must not publish someone's life.
examples/assistant/workspace/*
!examples/assistant/workspace/AGENTS.md
!examples/assistant/workspace/README.md
examples/assistant/config/

# telegram bridge state (learned owner chat id, etc.)
mcp_servers/telegram/data/

# ide
.idea/
.vscode/

# learning vault (local study notes)
learning doc/
