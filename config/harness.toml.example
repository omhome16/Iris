# harness.toml — declarative Iris configuration (copy to config/harness.toml)
#
# Precedence:  defaults  <  .env  <  this file  <  environment  <  CLI flag
#
# A *real* env var always wins (so a container/CI override still works) and this
# file wins over `.env`, because `.env` is where a copied sample's defaults live:
# `WORKSPACE_DIR=./workspace` there must not silently defeat a profile that names
# its own workspace. So: put the knobs you want a profile to own in this file, and
# leave `.env` for secrets. This file is safe to commit; secrets are not.
# SECRETS DO NOT BELONG HERE — keep API keys in .env.
#
# Every key is the lowercase name of a setting (see `iris doctor` / .env.example).
# Unknown keys are logged and ignored, so a typo is visible rather than silent.

# ── Channels (plug-and-play) ────────────────────────────────────────────────
# Core ships `telegram`. Install a plugin that registers a channel (entry-point
# group `iris_ai.channels`) and enable it here by name — no core edit.
# Empty `enabled` means "every registered channel"; `disabled` always wins.
[channels]
enabled = ["telegram"]
disabled = []

# ── Capability backends (plug-and-play) ─────────────────────────────────────
# Each capability is built through a registry, so a plugin that registers a
# backend can be selected by name — no core edit. The values below are the
# built-in defaults; uncomment to override.
# model_backend  = "litellm"    # ModelBackend:  `litellm` ships in core
# memory_backend = "sqlite"     # MemoryBackend: `sqlite` (default: one file, no daemon),
#                               #                `pgvector` (a service), `null` degrades
# judge_backend  = "jev"        # Judge:         `jev` ships in core

# ── Swappable pieces ────────────────────────────────────────────────────────
# Names below are the built-ins. A dotted path is your class: `pkg.mod:Class`.
# context: default | recall-first | minimal
# memory is `memory_backend`: sqlite | markdown | pgvector
# persona: blank | file | assistant | coder | researcher | tutor
# `off` turns capture or consolidation off. See docs/harness.md.
[components]
context = "default"
persona = "file"
capture = "default"
consolidator = "dreaming"

# Parallel agents. Built-in roles are researcher and critic.
# Add one with `iris new role <name>`, or write a table here.
[agents]
max_parallel = 3
max_calls_per_turn = 2
budget_usd = 0

# [roles.scribe]
# description = "Writes a short brief."
# prompt = "You are a specialist. Report what you found and where."
# tools = ["memory_search", "file_read"]
# model_tier = "cheap"
# max_steps = 3

# ── Examples of ordinary settings (uncomment to use) ────────────────────────
# llm_provider = "auto"
# tool_guard_enabled = true
# tool_max_calls_per_turn = 8
# computer_enabled = false
# iriS_timezone = "UTC"
#
# ── External tools: MCP servers ─────────────────────────────────────────────
# Servers live in `.mcp.json` (one file). Turn one on with `iris mcp add <preset>`.
# Presets: filesystem, fetch, github, git, brave-search, playwright, sqlite.
# mcp_servers_file = ".mcp.json"
